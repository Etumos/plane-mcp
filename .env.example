# Copy to .env and fill in, or export these directly in your shell / MCP
# client config. Only PLANE_API_KEY is required.

# Required: your Plane API token.
# Get one from Plane -> Workspace Settings -> API Tokens -> Add API token.
PLANE_API_KEY=REPLACE_WITH_YOUR_PLANE_API_TOKEN

# Optional: Plane API base URL. Defaults to the Plane Cloud API.
# Point this at your own instance for self-hosted Plane, e.g.:
#   PLANE_API_URL=https://plane.example.com
PLANE_API_URL=https://api.plane.so

# Optional: default workspace slug, used when a tool call omits
# workspace_slug (list_workspaces only).
PLANE_WORKSPACE_SLUG=

# Optional: restrict the exposed tool set to a comma-separated allowlist.
# Unset = every tool is enabled (permissive default).
# PLANE_MCP_ENABLED_TOOLS=list_projects,list_issues,get_issue,create_issue

# Optional: run as an HTTP/SSE service instead of stdio.
# PLANE_MCP_HTTP=1
# PLANE_MCP_HOST=0.0.0.0
# PLANE_MCP_PORT=8000
