# plane-project-mcp configuration — copy to .env and fill in.

# Your Plane API token (required).
# In Plane: Workspace Settings -> API Tokens -> Add API token.
# Treat it like a password.
PLANE_API_KEY=

# Plane API base URL.
# Defaults to https://api.plane.so (Plane Cloud).
# SELF-HOSTED USERS: change this to your own Plane instance,
# e.g. https://plane.yourcompany.com
PLANE_API_URL=https://api.plane.so

# Optional: default workspace slug (used when no slug is passed).
PLANE_WORKSPACE_SLUG=
